---
interface Props {
	command: string;
}
const { command } = Astro.props;
---

<div class="copy-cmd">
	<code><span class="prompt" aria-hidden="true">$</span> {command}</code>
	<button type="button" data-copy={command} aria-label="Copy the command">Copy</button>
</div>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
		button.addEventListener('click', async () => {
			await navigator.clipboard.writeText(button.dataset.copy!);
			button.textContent = 'Copied';
			setTimeout(() => (button.textContent = 'Copy'), 1500);
		});
	}
</script>

<style>
	.copy-cmd {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		background: var(--sl-color-gray-6);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 0.35rem 0.35rem 0.35rem 0.85rem;
		min-width: 0;
	}
	code {
		flex: 1;
		min-width: 0;
		overflow-x: auto;
		white-space: nowrap;
		font: 0.8rem/1.6 var(--sl-font-mono);
		color: var(--sl-color-white);
		scrollbar-width: thin;
	}
	.prompt {
		color: var(--sl-color-accent);
	}
	button {
		flex: none;
		font: 600 0.75rem/1 var(--sl-font);
		color: var(--sl-color-white);
		background: var(--sl-color-gray-5);
		border: 0;
		border-radius: 0.35rem;
		padding: 0.5rem 0.7rem;
		cursor: pointer;
	}
	button:hover {
		background: var(--sl-color-accent-low);
	}
	button:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
</style>
